{
	"$schema": "node_modules/wrangler/config-schema.json",
	// ⚠ **v0.1.0 の器**（⚠ 2026-08-28。`docs/adr/0050`）。
	//
	// ⚠ **β 版（`wrangler.jsonc` / `konjaku`）とは、⚠ 別の Worker。**
	//   ⚠ **β 版に一切触らない**ことが目的。⚠ `judged.ok` の観測が続く必要がある
	//   （⚠ `docs/adr/0047` の 3〜5 段目が、⚠ その観測に乗っている）。
	//
	// ⚠ **回し方**: ⚠ **`develop` への push で自動的に出る**（2026-08-29。`docs/adr/0070`）。
	//   ⚠ **検査が全部緑になったあとだけ走る**（`.github/workflows/check.yml` の `deploy-next`）。
	//   ⚠ **Workers Builds には足していない**（⚠ Cloudflare 側は検査の緑を待てない）。
	"name": "konjaku-next",
	"compatibility_date": "2026-08-11",

	// ⚠ **配るのは `public-next/` だけ。**⚠ `public/` を混ぜない。
	//   ⚠ **混ぜると「β 版を前提にしない」が、⚠ その時点で崩れる**
	//   （`docs/v0.1.0-何を解決するか.md` の決め事）。
	"assets": {
		"directory": "./public-next"
	},

	// ⚠ **合言葉で荷物を手渡す口**（2026-08-29。`docs/sync-api.md` / `docs/adr/0072`）。
	//   ⚠ **`docs/adr/0050` は「`main` を書かない」で始めていた。**⚠ **そこを決め直した。**
	//
	// ⚠ **静的アセットに一致する要求では、⚠ この Worker は起動しない。**
	//   ⚠ **`run_worker_first` を足さない。**⚠ **足すと、⚠ 場所つきの URL が Workers Logs に載る**
	//   （⚠ `wrangler.jsonc` の同じ注記。⚠ **画面の説明が黙って嘘になる**）。
	"main": "worker-next.js",

	// ⚠ **β 版と同じ DB を使う**（2026-08-29。Owner 判断。`docs/adr/0073`）。
	//   ⚠ **`docs/adr/0050` は「別の DB を作る」と決めていた。**⚠ **そこを決め直した。**
	//
	// ⚠ **表は分かれている**（`handoff` / `handoff_attempt` ／ β は `tick` / `health`）。
	//   ⚠ **β の表には触らない。**⚠ **それは `test/check/next.mjs` が機械で見ている。**
	//
	// ⚠ **行は混ざらないので、⚠ 計測への影響は無い**（2026-08-29。Owner 判断）。
	//   ⚠ **共有するのは枠だけ**（⚠ 書き込み 10万行/日・容量 5GB は DB 単位）。
	//   ⚠ **いまは効かない。**⚠ **近づいたら、⚠ `docs/adr/0073` の「戻すとき」を回す。**
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "konjaku",
			"database_id": "6ad7205d-59e3-44bf-ab75-18438f280eed"
		}
	],

	// ⚠ **画面に「◯分で消えます」を直書きさせない**（`docs/adr/0072`）。
	//   ⚠ **サーバが `ttl_sec` を返し、⚠ 画面はそこから文を作る。**⚠ **数字を 2 か所に持たない。**
	// ⚠ **既定値は `worker-next.js` の `DEFAULTS` が持つ。**⚠ ここは上書きするためだけに在る。
	"vars": {
		"HANDOFF_TTL_SEC": "300",
		"HANDOFF_MAX_PAYLOAD": "20000",
		"HANDOFF_ATTEMPT_LIMIT": "30",
		"HANDOFF_ATTEMPT_WINDOW_SEC": "60"
	}
}
