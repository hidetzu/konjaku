{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "konjaku",
	"compatibility_date": "2026-08-11",
	// 配信するのは public/ だけ。
	// ここを "." にすると、ビルド中に生成される node_modules まで
	// アップロード対象になり workerd（122MiB）が 25MiB 制限に引っかかる。
	"assets": {
		"directory": "./public"
	},
	// 計測だけのための Worker。静的アセットに一致するリクエストでは起動しないので、
	// ページの表示は従来どおり素の配信のまま（/t を叩いたときだけ動く）。
	"main": "worker.js",
	// 計測の貯め先。Workers Logs は保持3日しかなく、4日空けたらその期間の数字が
	// 永久に消える（＝様子見が成立しない）ので D1 に貯める。保持は無期限。
	// 無料枠は 書き込み10万行/日・読み500万行/日・容量5GB。
	//
	// ⚠ Analytics Engine（analytics_engine_datasets）は、このアカウントでは
	//   バインディングを付けるとデプロイが通らなかった（バインディングだけ外して
	//   押し直したらビルドが通ったので、原因はそこで確定している）。
	"d1_databases": [
		// ⚠ binding は DB ひとつだけ。worker.js が env.DB を使う。
		//   wrangler d1 create が binding:"konjaku" を自動で追記するので、
		//   作り直したときは重複していないか見ること（同じ DB に2本刺さる）。
		{
			"binding": "DB",
			"database_name": "konjaku",
			"database_id": "6ad7205d-59e3-44bf-ab75-18438f280eed"
		}
	],
	// ⚠ Workers Logs。**Worker が起動したときだけ**記録される。
	//   実測（2026-08-15・本番）で、どの経路が Worker を通るか切り分けた:
	//     /                       200（静的アセット。Worker は起動しない）
	//     /?q=<地名>&ll=<座標>     200（同上。⚠ **クエリは一致判定に影響しない**）
	//     /t                      405（worker.js の応答＝起動している）
	//     存在しないパス           404（worker.js の応答）
	//   → ⚠ **場所つきの URL は Worker を通らない**ので、ここには残らない。
	//     計測の受け口 /t も fetch("/t",{method:"POST"}) でクエリが付かない。
	//
	// ⚠ **画面がこの事実を書いている**（index.html / peel.html のプライバシーの節）。
	//   ここを変えるときは、画面も一緒に見ること。とくに:
	//   ⚠ `run_worker_first` を足すと**静的アセットでも Worker が起動する**ようになり、
	//     場所つき URL が Workers Logs に載る。**画面の説明が黙って嘘になる。**
	//   ⚠ プランを上げると **Logpush**（HTTP リクエストログの外部出力）が使えるようになる。
	//     有効にすると URL と IP が出力先へ流れる。画面は「使っていません」と書いている。
	//     いまは無料プランで、ダッシュボードに項目自体が無い（2026-08-15 に確認）。
	//   ⚠ どちらも Cloudflare 側の設定なので、**検査では止められない**。
	"observability": {
		"enabled": true
	}
}